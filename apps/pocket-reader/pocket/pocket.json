{
  "$schema": "https://pocketjs.dev/schema/pocket-2.json",
  "pocket": 2,
  "id": "dev.pocket-reader.pocket",
  "name": "pocket-reader",
  "title": "READER",
  "version": "1.0.0",
  "engine": {
    "capabilities": {
      "requires": [
        "text.glyphs.baked",
        "input.buttons"
      ]
    }
  },
  "app": {
    "entry": "src/main.tsx",
    "output": "pocket-reader",
    "framework": "solid",
    "viewport": {
      "fixed": {
        "logical": [
          360,
          240
        ],
        "presentation": "native"
      }
    }
  }
}
